<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.app.desktop.LoginController"
      alignment="CENTER" spacing="20" stylesheets="@../css/desktop.css">
    
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <VBox alignment="CENTER" spacing="8">
        <Label text="FoodXpress" styleClass="brand-title" style="-fx-font-size: 32px;"/>
        <Label text="Desktop Management Console" style="-fx-text-fill: #64748b; -fx-font-size: 14px;"/>
    </VBox>

    <VBox styleClass="card" spacing="16" maxWidth="380">
        <Label text="Sign In" styleClass="section-title"/>

        <Label fx:id="errorLabel" text="" style="-fx-text-fill: #ef4444;" visible="false" wrapText="true"/>

        <VBox spacing="4">
            <Label text="Username:"/>
            <TextField fx:id="usernameField" promptText="admin or customer1"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Password:"/>
            <PasswordField fx:id="passwordField" promptText="admin123 or pass123"/>
        </VBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="Sign In" fx:id="loginButton" onAction="#handleLogin" styleClass="btn-primary" defaultButton="true"/>
            <Button text="Quick Admin Demo" onAction="#handleQuickAdmin" styleClass="btn-secondary"/>
        </HBox>
    </VBox>
</VBox>
