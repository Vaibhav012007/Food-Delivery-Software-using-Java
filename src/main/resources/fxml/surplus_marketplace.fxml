<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.app.desktop.SurplusMarketplaceController"
      spacing="0" stylesheets="@../css/desktop.css">

    <!-- Top Navigation Bar -->
    <HBox styleClass="nav-bar">
        <Label text="FoodXpress Admin" styleClass="brand-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Dashboard" styleClass="nav-button" onAction="#goDashboard"/>
        <Button text="Restaurants" styleClass="nav-button" onAction="#goRestaurants"/>
        <Button text="Menus" styleClass="nav-button" onAction="#goMenus"/>
        <Button text="Orders" styleClass="nav-button" onAction="#goOrders"/>
        <Button text="Batches" styleClass="nav-button" onAction="#goBatches"/>
        <Button text="Surplus" styleClass="nav-button" onAction="#goSurplus"/>
        <Button text="Group Orders" styleClass="nav-button" onAction="#goGroupOrders"/>
        <Button text="Sign Out" styleClass="btn-secondary" onAction="#handleLogout"/>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20" right="24" bottom="20" left="24"/>
        </padding>

        <!-- Left Table -->
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Surplus Food Marketplace" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="⏰ Run Expiry Sweep" onAction="#handleExpireListings" styleClass="btn-secondary"/>
                <Button text="🔄 Refresh" onAction="#loadListings" styleClass="btn-secondary"/>
            </HBox>

            <Label fx:id="statusMessage" text="" wrapText="true" visible="false"/>

            <TableView fx:id="surplusTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="45"/>
                    <TableColumn fx:id="restaurantCol" text="Restaurant ID" prefWidth="90"/>
                    <TableColumn fx:id="itemCol" text="Item ID" prefWidth="70"/>
                    <TableColumn fx:id="origPriceCol" text="Original (₹)" prefWidth="85"/>
                    <TableColumn fx:id="discPriceCol" text="Discount (₹)" prefWidth="85"/>
                    <TableColumn fx:id="discountCol" text="Off %" prefWidth="60"/>
                    <TableColumn fx:id="qtyCol" text="Available" prefWidth="70"/>
                    <TableColumn fx:id="expiryCol" text="Expiry Time" prefWidth="150"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Right Side: Post Surplus Listing Form -->
        <VBox styleClass="card" spacing="12" prefWidth="300">
            <Label text="Post Surplus Listing" styleClass="section-title"/>

            <VBox spacing="4">
                <Label text="Restaurant ID:"/>
                <TextField fx:id="restaurantIdInput" text="1"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Menu Item ID:"/>
                <TextField fx:id="menuItemIdInput" text="1"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Available Quantity:"/>
                <TextField fx:id="quantityInput" text="10"/>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Original (₹):"/>
                    <TextField fx:id="origPriceInput" text="250.00"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Discounted (₹):"/>
                    <TextField fx:id="discPriceInput" text="100.00"/>
                </VBox>
            </HBox>

            <VBox spacing="4">
                <Label text="Expires in (Minutes):"/>
                <TextField fx:id="expiryMinutesInput" text="120"/>
            </VBox>

            <Button text="Post Listing" onAction="#handleCreateListing" styleClass="btn-primary" maxWidth="Infinity"/>
        </VBox>
    </HBox>
</VBox>
